<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.CallerIdentity" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/theme_color_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_color_dark</item>
        <item name="colorAccent">@color/theme_color_light</item>
        <item name="colorSurface">@color/card_surface</item>
        <item name="colorOnBackground">@color/black</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:statusBarColor">@color/theme_color_light</item>
        <item name="android:navigationBarColor">@color/screen_background</item>
        <item name="textColor">@color/black</item>
    </style>

    <style name="Theme.CallerIdentity" parent="Base.Theme.CallerIdentity" />

    <style name="CustomToolbarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="fontFamily">@font/brandy</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="CircleImageViewStyle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
